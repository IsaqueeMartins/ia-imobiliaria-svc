NODE_ENV=development
PORT=3000
TRUST_PROXY=false
LOG_LEVEL=info
BODY_LIMIT=1mb
APP_VERSION=

API_KEYS=local-dev-consumer-key,another-consumer-key:tenant-a

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_FALLBACK_MODELS=gemini-3.5-flash
GEMINI_INLINE_MAX_MB=15
GEMINI_INPUT_PRICE_PER_MILLION_USD=
GEMINI_OUTPUT_PRICE_PER_MILLION_USD=

AI_TEMPERATURE=0.2
AI_REQUEST_TIMEOUT=60000
AI_MAX_RETRIES=2
AI_RETRY_BASE_DELAY_MS=500
AI_RETRY_MAX_DELAY_MS=8000
AI_FALLBACK_ENABLED=true

MAX_DOCUMENT_SIZE_MB=50
MAX_DOCUMENT_PAGES=1000

R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_ENDPOINT=
R2_ALLOWED_KEY_PREFIXES=
R2_READINESS_CHECK=false

CORS_ORIGINS=http://localhost:3001
SWAGGER_ENABLED=true

RATE_LIMIT_ENABLED=true
RATE_LIMIT_TTL=60000
RATE_LIMIT_MAX=30

IDEMPOTENCY_ENABLED=true
IDEMPOTENCY_TTL_SECONDS=900
